# Block modifications to upstream template files in derived forks unless acknowledged
bun scripts/check-upstream-modifications.ts

# Regenerate Convex bindings when convex/ inputs change (turbo-cached; no-op on cache hit).
pnpm turbo run codegen --filter=@workspace/backend --output-logs=errors-only
git add services/backend/convex/_generated/

# Run lint-staged to only process staged files
pnpm lint-staged

# Fallow code audit (local only): dead code, complexity, and duplication on changed files (new issues only)
command -v fallow >/dev/null 2>&1 || exit 0
UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
if [ -n "$UPSTREAM" ]; then
  BASE="$(git merge-base "$UPSTREAM" HEAD 2>/dev/null || echo "$UPSTREAM")"
else
  BASE="master"
fi
fallow audit --base "$BASE" --dead-code-baseline .fallow/baseline.json --health-baseline .fallow/health-baseline.json --dupes-baseline .fallow/dupes-baseline.json --quiet --gate-marker pre-commit
