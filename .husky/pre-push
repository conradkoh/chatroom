#!/usr/bin/env sh

# Drain git's ref-update lines from stdin. Every destination runs the same checks,
# so the hook does not branch on the ref being pushed.
cat > /dev/null

# Script unit tests (bun).
bun run test:scripts

# Typecheck and unit tests for packages affected since the push base ref.
# E2E is not run here: GitHub Actions runs it for pull requests targeting master
# (.github/workflows/e2e.yml).
bash scripts/pre-push-checks.sh "${1:-origin}" "${2:-}"
