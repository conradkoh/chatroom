{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": true
    },
    "codegen": {
      "inputs": ["convex/**", "!convex/_generated/**", "package.json"],
      "outputs": ["convex/_generated/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^typecheck", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": false
    },
    // Package-specific tasks REPLACE the global task — they do not merge.
    // Always re-declare dependsOn and outputs from the global task when overriding.
    "@workspace/backend#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "@workspace/webapp#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/services/backend/src/**"],
      "cache": true
    },
    "@workspace/webapp#build": {
      "dependsOn": ["^typecheck", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },
    // One-shot Convex deployment must finish before the persistent backend
    // watcher and webapp dev server start, so clients never issue
    // operational-signal calls against a stale hosted validator shape.
    "@workspace/backend#dev:prepare": {
      "cache": false
    },
    "@workspace/backend#dev": {
      "dependsOn": ["@workspace/backend#dev:prepare"],
      "cache": false,
      "persistent": true
    },
    "@workspace/webapp#dev": {
      "dependsOn": ["@workspace/backend#dev:prepare"],
      "cache": false,
      "persistent": true
    }
  }
}
