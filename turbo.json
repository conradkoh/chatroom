{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!package.json"],
      "cache": true
    },
    "codegen": {
      "inputs": ["convex/**", "!convex/_generated/**", "package.json"],
      "outputs": ["convex/_generated/**"],
      "cache": true
    },
    // Every package.json is excluded from typecheck and test inputs, so a manifest-only edit to
    // version, scripts, bin, main, exports or types keeps cached results. Dependency changes still
    // invalidate through pnpm-lock.yaml (globalDependencies). After a manifest-only edit to exports,
    // types, scripts, bin or main, run `pnpm turbo run typecheck test --force` before trusting a cached pass.
    "test": {
      "dependsOn": ["^typecheck", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!package.json"],
      "outputs": [],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@workspace/backend#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SKIP_DEV_MIGRATIONS",
        "CONVEX_DEPLOY_KEY",
        "CONVEX_DEPLOYMENT",
        "CONVEX_URL",
        "VITE_CONVEX_URL"
      ]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": false
    },
    // Package-specific tasks REPLACE the global task — they do not merge.
    // Always re-declare dependsOn and outputs from the global task when overriding.
    "@workspace/backend#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!package.json"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "@workspace/webapp#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!package.json",
        "$TURBO_ROOT$/services/backend/src/**"
      ],
      "cache": true
    },
    "@workspace/webapp#build": {
      "dependsOn": ["^typecheck", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    }
  }
}
