{
  "name": "chatroom-cli",
  "version": "1.93.0",
  "description": "CLI for multi-agent chatroom collaboration",
  "type": "module",
  "bin": {
    "chatroom": "./dist/node-launch.js"
  },
  "scripts": {
    "build": "bun run typecheck && bun run build:local-web && bun run build.config.ts",
    "build:local-web": "vite build --config src/daemon/local-web/vite.config.ts",
    "typecheck": "tsc -b --force",
    "test": "bash ../../scripts/kill-stale-vitest.sh \"$PWD\" && vitest run",
    "test:integration": "bash ../../scripts/kill-stale-vitest.sh \"$PWD\" && vitest run --config vitest.integration.config.ts",
    "test:watch": "bash ../../scripts/kill-stale-vitest.sh \"$PWD\" && vitest",
    "chatroom": "bun run src/index.ts",
    "prepublishOnly": "bun run scripts/guard-workspace-publish.ts",
    "publish:prepare": "bun run scripts/prepare-npm-publish.ts",
    "publish:verify": "bun run scripts/verify-publish-artifacts.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.208",
    "@connectrpc/connect-node": "^1.6.1",
    "@cursor/sdk": "1.0.26",
    "@earendil-works/pi-coding-agent": "0.74.2",
    "@llamaindex/liteparse": "^1.4.2",
    "@opencode-ai/sdk": "^1.14.22",
    "@openai/codex": "0.147.0",
    "@openai/codex-sdk": "0.147.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.0",
    "convex": "^1.31.0",
    "convex-helpers": "^0.1.108",
    "effect": "^3.0.0",
    "ignore": "^7.0.0",
    "jsonc-parser": "^3.3.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.80.7",
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@workspace/backend": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.6"
  },
  "keywords": [
    "cli",
    "chatroom",
    "multi-agent",
    "convex"
  ],
  "author": "",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/conradkoh/chatroom"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/node-launch.js",
    "dist/node-launch.js.map",
    "src/daemon/local-web/client/build",
    "package.json",
    "README.md"
  ]
}
